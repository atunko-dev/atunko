{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: [
    "config:recommended",
    ":semanticCommits",
  ],

  semanticCommits: "enabled",
  semanticCommitType: "chore",
  semanticCommitScope: "{{datasource}}",

  separateMajorMinor: true,
  separateMultipleMajor: true,

  automergeType: "pr",
  platformAutomerge: true,

  // Trailing slash is load-bearing: the prefix is concatenated, not joined, so
  // "renovate" would yield branches like `renovatejunit-5.x`.
  branchPrefix: "renovate/",

  addLabels: [
    "bot-renovate",
  ],

  stopUpdatingLabel: "bot-renovate-stop",

  dependencyDashboard: false,

  // Each PR occupies two long-running CI jobs (build ~10 min, integration
  // ~3 min) against this org's 20-job concurrency cap, so 5 leaves half the
  // capacity for human PRs.
  prConcurrentLimit: 5,
  prHourlyLimit: 5,

  lockFileMaintenance: {
    enabled: true,
  },

  vulnerabilityAlerts: {
    enabled: true,
    addLabels: ["security"],
  },

  osvVulnerabilityAlerts: true,

  packageRules: [

    // =====================================================
    // Version constraints
    // =====================================================

    {
      matchDepNames: ["java", "openjdk", "temurin"],
      allowedVersions: "<=25",
    },

    // OpenRewrite now publishes only to the authenticated Code Genome Project.
    // Recipe BOM 3.38.0 is on Maven Central but needs CGP-only artifacts, so
    // each OpenRewrite dependency is capped at its first CGP-era version.
    {
      matchPackageNames: ["org.openrewrite.recipe:rewrite-recipe-bom"],
      allowedVersions: "<3.38.0",
    },
    {
      matchPackageNames: ["org.openrewrite:rewrite-bom"],
      allowedVersions: "<8.91.0",
    },
    {
      matchPackageNames: ["org.openrewrite.recipe:rewrite-migrate-java"],
      allowedVersions: "<3.43.0",
    },
    {
      matchPackageNames: ["org.openrewrite.recipe:rewrite-spring"],
      allowedVersions: "<6.38.0",
    },
    {
      matchPackageNames: ["org.openrewrite.recipe:rewrite-static-analysis"],
      allowedVersions: "<2.42.0",
    },

    // =====================================================
    // Version classification labels
    // =====================================================

    {
      matchUpdateTypes: ["major"],
      addLabels: ["renovate-version-major"],
      minimumReleaseAge: "30 days",
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["renovate-version-minor"],
      automerge: true,
      minimumReleaseAge: "10 days",
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["renovate-version-patch"],
      automerge: true,
      minimumReleaseAge: "10 days",
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["renovate-version-digest"],
    },
    {
      matchUpdateTypes: ["pin"],
      automerge: true,
    },

    // =====================================================
    // Gradle-specific tuning
    // =====================================================

    {
      matchManagers: ["gradle"],
      matchDepTypes: ["plugin"],
      addLabels: ["renovate-type-gradle-plugin"],
    },

    {
      matchManagers: ["gradle"],
      matchDatasources: ["java-version"],
      groupName: "java runtime",
      addLabels: ["renovate-type-java"],
    },

    // =====================================================
    // Ecosystem classification labels
    // =====================================================

    {
      matchDatasources: ["docker"],
      addLabels: ["renovate-type-container"],
    },

    {
      matchDatasources: ["java-version", "maven"],
      addLabels: ["renovate-type-java"],
    },

    {
      matchManagers: ["gradle"],
      addLabels: ["renovate-type-java"],
    },

    {
      matchDatasources: ["github-releases", "github-tags"],
      addLabels: ["renovate-type-cicd"],
    },

    {
      matchManagers: ["github-actions"],
      semanticCommitType: "chore",
      semanticCommitScope: "github-actions",
      addLabels: ["renovate-type-cicd"],
      // Actions majors (v3 → v4) carry input renames and runtime changes, so
      // they stay manual like every other major.
      matchUpdateTypes: ["minor", "patch", "pin"],
      automerge: true,
    },

    // No catch-all grouping rule. Grouping is left to config:recommended's
    // group:monorepos and group:recommended, which bundle things that genuinely
    // release together.
  ],
}
